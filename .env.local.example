# AI explanations — dual-provider fallback, set one (Anthropic tried first)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model for AI explanations
ANTHROPIC_EXPLAIN_MODEL=
OPENROUTER_EXPLAIN_MODEL=

# History & Analytics persistence — a Postgres connection string (Neon,
# or Vercel Postgres/Storage, which is Neon under the hood). Without this,
# History and Analytics show a "not connected" empty state; everything
# else in the app still works.
DATABASE_URL=

# Optional off-by-default Basic Auth gate. The app has no login screen by
# default (see README.md) — set BOTH to turn this gate on.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=
